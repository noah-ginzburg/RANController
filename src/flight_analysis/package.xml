<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>flight_analysis</name>
  <version>0.0.0</version>
  <description>Read a flight bag, print the raw messages, plot vicon vs onboard position.</description>
  <maintainer email="noah.ginzburg@gmail.com">noah</maintainer>
  <license>MIT</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <!-- message types stored in the bags this reads -->
  <exec_depend>vicon_receiver</exec_depend>
  <exec_depend>crazyflie_interfaces</exec_depend>
  <depend>python3-numpy</depend>
  <depend>python3-pandas</depend>
  <depend>python3-matplotlib</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
