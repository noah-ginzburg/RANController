  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>python3-pyqt5</depend>
  <depend>crazyflie_debug_interfaces</depend>
  <depend>crazyflie_interfaces</depend>
  <depend>geometry_msgs</depend>
